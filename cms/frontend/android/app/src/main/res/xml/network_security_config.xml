<?xml version="1.0" encoding="utf-8"?>
<!-- Allow LAN Nest API over HTTP for CMS_DEV_AUTH / local tablets. Prefer HTTPS in production. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
